/* 遥测页专有样式（公共部分见 app.wxss） */

.map {
  width: 100%;
  height: 640rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 12rpx;
}

.lg {
  font-size: 22rpx;
  color: #6b7280;
}

.lg-traj { color: #2563eb; }
.lg-pose { color: #dc2626; }
.lg-wp { color: #f59e0b; }
.lg-circle { color: #7c3aed; }

.cam {
  width: 100%;
  height: 380rpx;
  background: #111827;
  border-radius: 12rpx;
}

.info-val.bad {
  color: #b91c1c;
}
