/* 遥控页专有样式（公共部分见 app.wxss） */

.joy-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 12rpx;
}

.joy-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.shift-btn {
  width: 150rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  font-size: 26rpx;
  border-radius: 16rpx;
  background: #e0e7ff;
  color: #4338ca;
}

.shift-btn:active {
  background: #c7d2fe;
}

.stop-btn {
  width: 130rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  background: #ef4444;
  color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(239, 68, 68, 0.35);
}

.stop-btn:active {
  background: #dc2626;
}

.raw-panel {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.raw-input {
  flex: 1;
  height: 68rpx;
  background: #f4f4f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
}

.raw-send {
  width: 130rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  background: #3b82f6;
  color: #ffffff;
  border-radius: 12rpx;
  flex-shrink: 0;
}
