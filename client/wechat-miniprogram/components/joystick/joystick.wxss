.joy {
  position: relative;
  border-radius: 50%;
  background: linear-gradient(180deg, #eef2f7, #dbe2ea);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.10), 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  overflow: hidden;
}

.joy-active {
  background: linear-gradient(180deg, #e3ecf5, #cdd9e6);
}

.joy-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 66%;
  height: 66%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  border: 2rpx solid rgba(59, 130, 246, 0.25);
  box-sizing: border-box;
}

.joy-cross-h,
.joy-cross-v {
  position: absolute;
  left: 50%;
  top: 50%;
  background: rgba(59, 130, 246, 0.12);
}

.joy-cross-h {
  width: 66%;
  height: 2rpx;
  transform: translate(-50%, -50%);
}

.joy-cross-v {
  height: 66%;
  width: 2rpx;
  transform: translate(-50%, -50%);
}

.joy-knob {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 46%;
  height: 46%;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #60a5fa, #3b82f6 70%);
  box-shadow: 0 4rpx 10rpx rgba(37, 99, 235, 0.45);
  box-sizing: border-box;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
}
